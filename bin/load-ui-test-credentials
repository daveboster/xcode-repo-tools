#!/usr/bin/env bash

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  printf 'Source this script so it can export variables into your shell:\n' >&2
  printf '  source bin/load-ui-test-credentials\n' >&2
  exit 1
fi

xrt_ui_test_keychain_service="${XRT_UI_TEST_KEYCHAIN_SERVICE:-xcode-repo-tools-ui-tests}"
xrt_ui_test_username_account="${XRT_UI_TEST_USERNAME_ACCOUNT:-TEST_USERNAME}"
xrt_ui_test_password_account="${XRT_UI_TEST_PASSWORD_ACCOUNT:-TEST_PASSWORD}"

xrt_read_keychain_password() {
  local account="$1"

  if ! command -v security >/dev/null 2>&1; then
    return 1
  fi

  security find-generic-password \
    -s "$xrt_ui_test_keychain_service" \
    -a "$account" \
    -w 2>/dev/null
}

xrt_prompt_secret() {
  local prompt="$1"
  local value

  printf '%s' "$prompt" >&2
  IFS= read -r -s value
  printf '\n' >&2
  printf '%s\n' "$value"
}

if [[ -z "${TEST_USERNAME:-}" ]]; then
  if ! TEST_USERNAME="$(xrt_read_keychain_password "$xrt_ui_test_username_account")"; then
    TEST_USERNAME="$(xrt_prompt_secret 'TEST_USERNAME: ')"
  fi
  export TEST_USERNAME
fi

if [[ -z "${TEST_PASSWORD:-}" ]]; then
  if ! TEST_PASSWORD="$(xrt_read_keychain_password "$xrt_ui_test_password_account")"; then
    TEST_PASSWORD="$(xrt_prompt_secret 'TEST_PASSWORD: ')"
  fi
  export TEST_PASSWORD
fi

unset -f xrt_read_keychain_password
unset -f xrt_prompt_secret
unset xrt_ui_test_keychain_service
unset xrt_ui_test_username_account
unset xrt_ui_test_password_account
