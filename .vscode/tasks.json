{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Bats unit tests",
      "type": "shell",
      "command": "bats",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Bats integration tests",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source bin/load-ui-test-credentials && bats integration"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run all Bats tests",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source bin/load-ui-test-credentials && bats test integration"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
